{
  "name": "cipherquest",
  "productName": "CipherQuest",
  "version": "1.0.0",
  "description": "A terminal-style cybersecurity education game. Learn how attacks work — and how to defend — inside a safe, fully simulated sandbox.",
  "main": "main.js",
  "author": "CipherQuest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/notisaac132-star/cool-hecker-tool.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cipherquest.game",
    "productName": "CipherQuest",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CipherQuest-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.education",
      "artifactName": "CipherQuest-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "CipherQuest ${version}"
    }
  }
}
